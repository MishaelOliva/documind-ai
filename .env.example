# LLM Configuration
# Options: "gemini", "ollama", "mock" (default fallback for zero-setup local dev/testing)
LLM_PROVIDER=mock

# Google Gemini API Settings (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Local Settings (if running Ollama locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Retrieval & Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=3

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
