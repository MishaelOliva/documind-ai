# ---------------------------------------------------------------------------
# DocuMind configuration. Copy to `.env` and edit. Every value below is optional;
# the defaults run fully offline with no API keys.
# ---------------------------------------------------------------------------

# LLM provider used for answer synthesis.
#   "mock"   - deterministic offline sentence extractor (default, no key needed)
#   "gemini" - Google Gemini via API key
#   "ollama" - a local Ollama server
# If a remote provider is configured but its call fails, the system falls back
# to the deterministic extractor and reports the provider that actually ran.
LLM_PROVIDER=mock

# Google Gemini. Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama, for local models.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Chunking. Chunk size is in characters, not tokens.
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=3

# Grounding guard. Queries whose best cosine similarity falls below this value
# are refused instead of answered. The sample policy (Section 4.2) specifies
# 0.35; see the README "Limitations" section for why that value is necessary
# but not sufficient.
MIN_SIMILARITY_SCORE=0.35

# Maximum accepted upload size, in bytes (10 MB).
MAX_UPLOAD_SIZE_BYTES=10485760

# Server
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS. Leave empty to serve same-origin only, which is what the bundled SPA
# needs. Set a JSON list to allow a separately hosted frontend, for example:
# CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGINS=[]

# Python-style list; must stay in sync with the loader, which uses the same value.
ALLOWED_EXTENSIONS=[".pdf", ".txt", ".md", ".csv"]
